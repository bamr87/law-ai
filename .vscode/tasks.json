{
  // All tasks run inside Docker via the Makefile. No host Python or Node
  // toolchain is required. See AGENTS.md "Docker-First Workflow" and the
  // Makefile for details. Pair with .vscode/launch.json (Docker attach).
  //
  // Note: there is no built-in `$pytest` problem matcher in VS Code —
  // pytest tasks intentionally declare an empty matcher rather than a
  // nonexistent one (which broke task resolution warnings and captured
  // nothing).
  "version": "2.0.0",
  "inputs": [
    {
      "id": "pytestArgs",
      "type": "promptString",
      "description": "pytest args (e.g. tests/agents/test_legal_analyst.py::TestDefaultPath -q  |  -k citation)",
      "default": "-q --tb=short"
    },
    {
      "id": "manageCmd",
      "type": "promptString",
      "description": "Django manage.py command (e.g. migrate, lsat_export --out var/lsat_site)",
      "default": "migrate"
    }
  ],
  "tasks": [
    {
      "label": "Docker: Start Full Stack",
      "type": "shell",
      "command": "make dev",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Start Full Stack (Debug)",
      "detail": "Starts stack with debug ports (5678 backend, 5679 worker, 9229/9230 frontend) — then use launch.json attach configs",
      "type": "shell",
      "command": "make debug",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop Stack",
      "type": "shell",
      "command": "make down",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Tail Logs",
      "type": "shell",
      "command": "make logs",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Backend Shell",
      "type": "shell",
      "command": "make shell-backend",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Frontend Shell",
      "type": "shell",
      "command": "make shell-frontend",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Run All Tests",
      "type": "shell",
      "command": "make test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Backend Tests",
      "type": "shell",
      "command": "make test-backend",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Backend Single Test (prompt)",
      "detail": "Run one backend test file/node/keyword inside the container. Start DBs first if the test touches Postgres/Neo4j.",
      "type": "shell",
      "command": "docker compose run --rm --no-deps backend pytest ${input:pytestArgs}",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Frontend Tests",
      "type": "shell",
      "command": "make test-frontend",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Coverage Report",
      "type": "shell",
      "command": "make test-coverage",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Integration Tests (real DBs)",
      "type": "shell",
      "command": "make test-integration",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: LegalBench Eval",
      "type": "shell",
      "command": "make test-legalbench",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Spec & Backlog Validators",
      "type": "shell",
      "command": "make lint-specs",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Evolve: Discovery Audit",
      "detail": "python3 scripts/evolve_audit.py + spec/backlog validators (host stdlib only)",
      "type": "shell",
      "command": "make evolve-audit",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Autonomy: Run Cycle (dry-run)",
      "detail": "One autonomy cycle with --dry-run (requires AUTONOMY_ENABLED=True in .env to run for real)",
      "type": "shell",
      "command": "make autonomy-run KIND=test_pillar DRY_RUN=--dry-run",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Autonomy: Beat Status",
      "type": "shell",
      "command": "make autonomy-status",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "LSAT: Export Static Site Data",
      "type": "shell",
      "command": "make lsat-export",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Agents: LSAT Author Demo",
      "type": "shell",
      "command": "make lsat-author-demo",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Agents: Legal Analyst (IRAC) Demo",
      "type": "shell",
      "command": "make legal-analyst-demo",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Format & Lint All",
      "type": "shell",
      "command": "make lint",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Type Check (mypy + tsc)",
      "type": "shell",
      "command": "make typecheck",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Migrate",
      "type": "shell",
      "command": "make migrate",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Manage.py (prompt)",
      "type": "shell",
      "command": "make manage CMD='${input:manageCmd}'",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Ingest Sample Data",
      "type": "shell",
      "command": "make ingest",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Reset Local DBs (Dangerous)",
      "type": "shell",
      "command": "docker compose down -v && docker compose up -d neo4j postgres redis --wait && docker compose run --rm --no-deps backend sh -c \"python manage.py migrate --noinput && python manage.py ensure_checkpointer\"",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Local AI Stack Up",
      "type": "shell",
      "command": "make local-ai-up",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Pull Local AI Models",
      "type": "shell",
      "command": "make local-ai-pull",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Local AI Health Check",
      "type": "shell",
      "command": "make local-ai-health",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    }
  ]
}
