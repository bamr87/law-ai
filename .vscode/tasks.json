{
  // All tasks run inside Docker via the Makefile. No host Python or Node
  // toolchain is required. See AGENTS.md "Docker-First Workflow" and the
  // Makefile for details. Pair with .vscode/launch.json (Docker attach).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Start Full Stack",
      "type": "shell",
      "command": "make dev",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Start Full Stack (Debug)",
      "detail": "Starts stack with debugpy/inspect ports exposed (5678 backend, 5679 worker, 9229 frontend)",
      "type": "shell",
      "command": "make debug",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop Stack",
      "type": "shell",
      "command": "make down",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Tail Logs",
      "type": "shell",
