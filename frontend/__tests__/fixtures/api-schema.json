        "choices"
      ],
      "title": "PublicQuestion",
      "type": "object"
    },
    "LsatTutorRequest": {
      "$defs": {
        "TutorTrace": {
          "description": "What the learner actually did on this attempt (BL-20260429-18).\n\nThe tutor's distinguishing promise is coaching addressed to *this*\nreasoning, not a generic rationale \u2014 \"you ruled out B and D, so the split\nyou cared about was ...\" rather than \"the answer is C because ...\". None of\nit is inferable server-side: elimination, hint reveals and time live in the\nlab, so the client sends them or the tutor works without them.\n\nEvery field is optional. A client that captures none of this gets exactly\nthe behaviour it had before the field existed.",
          "properties": {
            "eliminated": {
              "description": "Choices the learner ruled out before answering.",
              "items": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ],
                "type": "string"
              },
              "maxItems": 5,
              "title": "Eliminated",
              "type": "array"
            },
            "hints_used": {
              "default": 0,
              "description": "Solve-assist steps revealed on this question (spec 045).",
              "maximum": 50,
              "minimum": 0,
              "title": "Hints Used",
              "type": "integer"
            },
            "prior_choices": {
              "description": "Answers tried on earlier attempts at this question.",
              "items": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ],
                "type": "string"
              },
              "maxItems": 5,
              "title": "Prior Choices",
              "type": "array"
            },
            "seconds_on_question": {
              "anyOf": [
                {
                  "maximum": 86400.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Wall-clock seconds spent before asking.",
              "title": "Seconds On Question"
            }
          },
          "title": "TutorTrace",
          "type": "object"
        }
      },
      "properties": {
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "refresh": {
          "default": false,
          "description": "Bypass the walkthrough cache and force a fresh model call (spec 041 FR-13).",
          "title": "Refresh",
          "type": "boolean"
        },
        "stream_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Client-chosen WebSocket correlation id (BL-20260811-15). Subscribe to /ws/agents/<stream_id> BEFORE posting and the tutor publishes its progress there \u2014 a cache hit, which tier it is waiting on, a fallback \u2014 instead of leaving the learner watching a spinner for the length of a hosted call.",
          "title": "Stream Id"
        },
        "stream_tokens": {
          "default": false,
          "description": "Stream the coaching token by token over ``stream_id`` (BL-20260503-03). Requires ``stream_id``; without one it is ignored, since there is nowhere to send the deltas. The streamed variant asks the model for prose rather than JSON \u2014 a partial JSON object is not a document \u2014 so its wording differs slightly from the buffered one.",
          "title": "Stream Tokens",
          "type": "boolean"
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/TutorTrace"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the learner did on this attempt \u2014 eliminations, hints revealed, time spent, earlier picks (BL-20260429-18). Optional; without it the coaching addresses only the answer they chose."
        },
        "user_choice": {
          "anyOf": [
            {
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The answer the learner picked. Optional \u2014 omit for a generic walkthrough.",
          "title": "User Choice"
        },
        "user_question": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-form follow-up the learner wants the tutor to address.",
          "title": "User Question"
        }
      },
      "required": [
        "question_id"
      ],
      "title": "TutorRequest",
      "type": "object"
    },
