{
  "version": 1,
  "meta": {
    "name": "Backlog Triage",
    "description": "Monthly: verify open BACKLOG items against the code and open ONE reconciliation PR (append-only; items move to Done, never deleted)."
  },
  "nodes": [
    {
      "id": "ec",
      "type": "trigger.cron",
      "position": {
        "x": 40,
        "y": 90
      },
      "config": {
        "cron": "0 9 1 * *"
      }
    },
    {
      "id": "em",
      "type": "trigger.manual",
      "position": {
        "x": 40,
        "y": 210
      },
      "config": {
        "mode": "plan-first"
      }
    },
    {
      "id": "eg",
      "type": "gate.enablement",
      "position": {
        "x": 250,
        "y": 150
      },
      "config": {
        "variable": "BACKLOG_TRIAGE_ENABLED"
      }
    },
    {
      "id": "erl",
      "type": "rate.limiter",
      "position": {
        "x": 440,
        "y": 150
      },
      "config": {
        "maxPerDay": 1
      }
    },
    {
      "id": "ea",
      "type": "agent.claude",
      "position": {
        "x": 630,
        "y": 150
      },
      "config": {
        "promptRef": ".factory/prompts/backlog-triage.md",
        "model": "claude-sonnet-5-5",
        "maxTurns": 30,
        "checks": "python3 scripts/spec_validator.py\npython3 scripts/backlog_lint.py"
      }
    },
    {
      "id": "epr",
      "type": "sink.open_pr",
      "position": {
        "x": 870,
        "y": 150
      },
      "config": {
        "branchHint": "factory/triage-*"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "ec",
        "port": "out"
      },
      "to": {
        "node": "eg",
        "port": "in"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "em",
        "port": "out"
      },
      "to": {
        "node": "eg",
        "port": "in"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "eg",
        "port": "out"
      },
      "to": {
        "node": "erl",
        "port": "in"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "erl",
        "port": "out"
      },
      "to": {
        "node": "ea",
        "port": "in"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "ea",
        "port": "out"
      },
      "to": {
        "node": "epr",
        "port": "in"
      }
    }
  ]
}
