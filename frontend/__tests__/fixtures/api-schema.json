{
  "$comment": "Generated by `manage.py export_api_schema` \u2014 do not hand-edit. Regenerate with `make manage CMD=export_api_schema`.",
  "contracts": {
    "AnalysisRequest": {
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "jurisdiction": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jurisdiction"
        },
        "matter_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matter Id"
        },
        "stream_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Id"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "thread_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "use_langgraph": {
          "default": true,
          "title": "Use Langgraph",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "AnalysisRequest",
      "type": "object"
    },
    "AnalysisResponse": {
      "$defs": {
        "AgentTraceEntry": {
          "properties": {
            "agent": {
              "title": "Agent",
              "type": "string"
            },
            "confidence": {
              "title": "Confidence",
              "type": "number"
            },
            "latency_ms": {
              "title": "Latency Ms",
              "type": "number"
            },
            "trace_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Trace Id"
            }
          },
          "required": [
            "agent",
            "trace_id",
            "latency_ms",
            "confidence"
          ],
          "title": "AgentTraceEntry",
          "type": "object"
        },
        "IRACOutput": {
          "properties": {
            "application": {
              "description": "Application of rules to facts",
              "title": "Application",
              "type": "string"
            },
            "conclusion": {
              "description": "Conclusion and recommended action",
              "title": "Conclusion",
              "type": "string"
            },
            "confidence": {
              "default": 0.0,
              "maximum": 1.0,
              "minimum": 0.0,
              "title": "Confidence",
              "type": "number"
            },
            "degraded": {
              "default": false,
              "description": "True when no real analysis ran (unimplemented/offline path). Degraded output must be excluded from confidence aggregation and always forces human review.",
              "title": "Degraded",
              "type": "boolean"
            },
            "degraded_reason": {
              "anyOf": [
                {
                  "enum": [
                    "engine_unavailable",
                    "offline_fallback"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Which degraded path produced this row (BL-20260810-16). `engine_unavailable`: the LangGraph engine could not start, so the advice is to start a provider (Ollama when the chain is pinned local). `offline_fallback`: every tier in LLM_PROVIDER_CHAIN failed. The UI needs the difference: only one of them is fixed by `make local-ai-up`. The `[ENGINE UNAVAILABLE]` / `[OFFLINE FALLBACK]` prefixes in `rule` stay as the signal for payloads written before this field existed.",
              "title": "Degraded Reason"
            },
            "issue": {
              "description": "Key legal issue identified",
              "title": "Issue",
              "type": "string"
            },
            "langgraph_thread_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "LangGraph checkpoint thread id; resume with the same id.",
              "title": "Langgraph Thread Id"
            },
            "phoenix_trace_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Deep-link to the Phoenix span tree (spec 010 FR-3).",
              "title": "Phoenix Trace Url"
            },
            "reasoning_trace": {
              "items": {
                "type": "string"
              },
              "title": "Reasoning Trace",
              "type": "array"
            },
            "requires_review": {
              "default": false,
              "description": "Structured HITL flag: True when this output must be reviewed by a human (unverified citations, refusal, or degraded path).",
              "title": "Requires Review",
              "type": "boolean"
            },
            "resumed": {
              "default": false,
              "description": "True when the requested `thread_id` already had persisted state before this run \u2014 i.e. the run resumed a thread rather than starting one (BL-20260810-13).",
              "title": "Resumed",
              "type": "boolean"
            },
            "retrieval": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Retrieval coverage envelope (queries, result_count, jurisdiction_requested, coverage_note) when a retrieval-backed path ran \u2014 constitution \u00a713 'absence is reported'.",
              "title": "Retrieval"
            },
            "rule": {
              "description": "Applicable legal rules / black letter law",
              "title": "Rule",
              "type": "string"
            },
            "sources": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "title": "Sources",
              "type": "array"
            },
            "trace_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Provenance trace_id from log_agent_call",
              "title": "Trace Id"
            }
          },
          "required": [
            "issue",
            "rule",
            "application",
            "conclusion"
          ],
          "title": "IRACOutput",
          "type": "object"
        },
        "Precedent": {
          "properties": {
            "attribution": {
              "additionalProperties": true,
              "description": "Constitution \u00a713 issuing authority (court, jurisdiction, decided_at, binding/persuasive) read off the graph node \u2014 BL-20260803-04.",
              "title": "Attribution",
              "type": "object"
            },
            "case_id": {
              "title": "Case Id",
              "type": "string"
            },
            "court": {
              "title": "Court",
              "type": "string"
            },
            "distinguishing_factors": {
              "items": {
                "type": "string"
              },
              "title": "Distinguishing Factors",
              "type": "array"
            },
            "graph_confidence": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "`confidence` stored on the :Case node.",
              "title": "Graph Confidence"
            },
            "relevance_score": {
              "title": "Relevance Score",
              "type": "number"
            },
            "retrieval_mode": {
              "default": "lexical",
              "description": "`lexical` (fulltext hit) or `citation_expansion` (CITES hop).",
              "title": "Retrieval Mode",
              "type": "string"
            },
            "source": {
              "default": "",
              "description": "Ingestion source recorded on the graph node.",
              "title": "Source",
              "type": "string"
            },
            "title": {
              "title": "Title",
              "type": "string"
            },
            "url": {
              "title": "Url",
              "type": "string"
            },
            "year": {
              "title": "Year",
              "type": "integer"
            }
          },
          "required": [
            "case_id",
            "title",
            "court",
            "year",
            "relevance_score",
            "url"
          ],
          "title": "Precedent",
          "type": "object"
        },
        "PrecedentList": {
          "properties": {
            "confidence": {
              "title": "Confidence",
              "type": "number"
            },
            "coverage_note": {
              "default": "",
              "description": "Verbatim coverage envelope from the retriever \u2014 what the corpus could and could not answer (constitution \u00a713).",
              "title": "Coverage Note",
              "type": "string"
            },
            "degraded": {
              "default": false,
              "description": "True when no real retrieval ran (unimplemented/offline path). Degraded output must never be presented as genuine search results.",
              "title": "Degraded",
              "type": "boolean"
            },
            "precedents": {
              "items": {
                "$ref": "#/$defs/Precedent"
              },
              "title": "Precedents",
              "type": "array"
            },
            "requires_review": {
              "default": false,
              "description": "Structured HITL flag: True when at least one retrieved precedent is emitted without a complete issuing authority (court + jurisdiction + decided_at). Carrying attribution is not the same as having it \u2014 an under-attributed precedent must be looked at before it is relied on (constitution \u00a713, BL-20260803-04).",
              "title": "Requires Review",
              "type": "boolean"
            },
            "summary": {
              "title": "Summary",
              "type": "string"
            },
            "trace_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Provenance trace_id from log_agent_call",
              "title": "Trace Id"
            }
          },
          "required": [
            "precedents",
            "summary",
            "confidence"
          ],
          "title": "PrecedentList",
          "type": "object"
        }
      },
      "properties": {
        "agent_trace": {
          "items": {
            "$ref": "#/$defs/AgentTraceEntry"
          },
          "title": "Agent Trace",
          "type": "array"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "irac": {
          "$ref": "#/$defs/IRACOutput"
        },
        "langgraph_thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Langgraph Thread Id"
        },
        "latency_ms": {
          "title": "Latency Ms",
          "type": "integer"
        },
        "phoenix_trace_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phoenix Trace Url"
        },
        "precedents": {
          "$ref": "#/$defs/PrecedentList"
        },
        "requires_human_review": {
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "resumed": {
          "default": false,
          "description": "True when the requested thread_id already held checkpointed state and this run continued it (BL-20260810-13).",
          "title": "Resumed",
          "type": "boolean"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "id",
        "timestamp",
        "latency_ms",
        "confidence",
        "requires_human_review",
        "irac",
        "precedents",
        "agent_trace"
      ],
      "title": "AnalysisResponse",
      "type": "object"
    },
    "IRACOutput": {
      "properties": {
        "application": {
          "description": "Application of rules to facts",
          "title": "Application",
          "type": "string"
        },
        "conclusion": {
          "description": "Conclusion and recommended action",
          "title": "Conclusion",
          "type": "string"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "degraded": {
          "default": false,
          "description": "True when no real analysis ran (unimplemented/offline path). Degraded output must be excluded from confidence aggregation and always forces human review.",
          "title": "Degraded",
          "type": "boolean"
        },
        "degraded_reason": {
          "anyOf": [
            {
              "enum": [
                "engine_unavailable",
