# Law AI Environment Configuration
# Copy to .env and fill in values

# === LLM provider chain (spec 034) ===
# Tried left to right; the first provider that is configured AND answers serves
# the request. Claude is the product-runtime default (constitution §1, amended
# 2026-08-11); local Ollama is the last-resort fallback that keeps the product
# answering — and answering locally — when both hosted tiers are unreachable.
# Pin a single provider by naming only it, e.g. LLM_PROVIDER_CHAIN=ollama —
# the only configuration that keeps prompt text on the host, and the required
# one for data under a confidentiality obligation forbidding third-party
# processing. xAI joined as tier 3 in spec 050 (constitution §1, amended
# 2026-09-04); it is inert until you run `make xai-login`.
LLM_PROVIDER_CHAIN=claude_code,anthropic_api,xai,ollama

# Tier 1 — Claude over a subscription OAuth token (`claude setup-token`).
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# Tier 2 — Claude over a standard API key.
# ANTHROPIC_API_KEY=sk-ant-api03-...
# Model id for both Claude tiers. ANTHROPIC_MODEL overrides it for tier 2 only.
CLAUDE_CODE_MODEL=claude-opus-5
# ANTHROPIC_MODEL=
# Thinking is on by default on Opus 5 and max_tokens caps thinking + response
# together, so keep this generous or answers truncate mid-document.
CLAUDE_CODE_MAX_TOKENS=8192
CLAUDE_CODE_REQUEST_TIMEOUT_S=60
CLAUDE_CODE_MAX_RETRIES=3
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Reasoning depth: low | medium | high | xhigh | max. Empty = API default (high).
CLAUDE_EFFORT=

# === Tier 3 — xAI Grok over a subscription OAuth token (spec 050) ===
# There is no API-key tier: run `make xai-login` (device-code flow, works from
# inside the container) with an active SuperGrok or X Premium+ subscription.
# Tokens land in backend/.xai/credentials.json and rotate on every refresh, so
# that file — not these variables — is the live credential.
XAI_MODEL=grok-4.6
# Optional faster Grok id for user-facing calls only (LSAT tutor, interactive
# IRAC); blank uses XAI_MODEL everywhere. Grok measured 5-10x the Claude tiers
# on this product's work, which is why the timeout below is 240s — fine for a
# batch fallback, slow for someone waiting (BL-20260905-11). Measure a
# candidate against a real subscription before setting it.
# XAI_INTERACTIVE_MODEL=
XAI_MAX_TOKENS=8192
# Grok is a reasoning model: a full IRAC analysis measured 56-103s live, so this
# is deliberately far higher than the Claude tiers' 60s. A read timeout is NOT
# retried (retrying replays the same slow work) — the chain falls through.
XAI_REQUEST_TIMEOUT_S=240
XAI_MAX_RETRIES=3
XAI_BASE_URL=https://api.x.ai/v1
XAI_AUTH_BASE_URL=https://auth.x.ai
# XAI_CREDENTIALS_PATH=.xai/credentials.json
# Seed a deployment that cannot run the login flow interactively. The file wins
# once written, because it is the copy that stays current through rotation.
# XAI_REFRESH_TOKEN=
# XAI_ACCESS_TOKEN=

# Per-token prices, so every llm_call audit event carries cost_usd next to its
# token counts and hosted spend is attributable per agent (BL-20260811-21).
# JSON object keyed by "provider/model", "model" or "provider" (that order);
# empty means tokens are still logged and cost is null. Prices change — keep
# them here, not in code.
# LLM_PRICE_TABLE={"claude_code/claude-opus-5":{"in_per_mtok":5,"out_per_mtok":25},"xai/grok-4.6":{"in_per_mtok":3,"out_per_mtok":15}}

# A tier whose credential is rejected (401/403) is skipped for this many
# seconds instead of re-earning the same failure on every request
# (BL-20260811-23); 0 disables the memory. Fail-fast turns a permanent failure
# into an error instead of falling through to a lower tier — off by default,
# because an honest local answer beats no answer (constitution §13).
LLM_PERMANENT_FAILURE_TTL_S=300
LLM_FAIL_FAST_ON_PERMANENT=false

# === Tier 4 — local Ollama (open-weights fallback) ===
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.1:70b-q4_K_M
FALLBACK_MODEL=mistral:7b-instruct-q4_K_M
# Spec 010: model the LangGraph LegalWorkflow uses by default. Apple Silicon
# laptops should keep this at the 7B Mistral; bump to llama3.1:8b on 64 GB+
# machines or llama3.1:70b-q4_K_M on workstations with NVIDIA GPUs.
OLLAMA_DEFAULT_MODEL=mistral:7b-instruct-q4_K_M
# Total attempts per Ollama call on transient failures (connect/read-timeout,
# 429, 5xx) with short exponential backoff; 1 disables retry.
OLLAMA_MAX_RETRIES=2
# Local embedding model used by the LSAT factory's paraphrase dedup gate
# (BL-20260702-01). The compose stack pulls it at bootstrap; when it is absent
# intake falls back to token-Jaccard alone and says so on the result.
OLLAMA_EMBED_MODEL=nomic-embed-text

# === Linux + NVIDIA workstation tier (docker-compose.gpu.yml, BL-20260502-02) ===
# Read ONLY by the GPU overlay (`make local-ai-up-gpu` / `make dev-gpu`), which
# is why they are GPU_-prefixed: the laptop values above stay in force for
# `make dev`, and a workstation cannot be silently handed the 7B default by a
# .env copied from this file. Defaults shown; uncomment to override.
# GPU_OLLAMA_DEFAULT_MODEL=llama3.1:70b-q4_K_M
# GPU_OLLAMA_BOOTSTRAP_MODELS=llama3.1:70b-q4_K_M mistral:7b-instruct-q4_K_M llama3.1:8b-instruct-q4_K_M nomic-embed-text
# GPU_OLLAMA_KEEP_ALIVE=30m
# GPU_OLLAMA_NUM_PARALLEL=2

# Optional vLLM server (`make vllm-up`, compose profile `vllm`, port 8001).
# OpenAI-compatible and Prometheus-instrumented, but NOT a provider-chain tier:
# law_ai.core.llm has no OpenAI-compatible provider, and adding one is a
# constitution §1 decision. Gated HF repos need a token that accepted the
# license. VLLM_TENSOR_PARALLEL_SIZE is the multi-GPU knob (one rank per card).
# VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# VLLM_TENSOR_PARALLEL_SIZE=1
# VLLM_MAX_MODEL_LEN=8192
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# HUGGING_FACE_HUB_TOKEN=

# === LangGraph state persistence (spec 010 FR-2) ===
# postgres = durable (default), redis = fast queues, memory = tests only.
LANGGRAPH_CHECKPOINTER=postgres
# Schema the checkpoint tables live in. `manage.py ensure_checkpointer` creates
# it and the saver connects with `options=-csearch_path=<schema>`, so setup()
# lands here rather than in `public` (BL-20260811-25).
LANGGRAPH_CHECKPOINTER_SCHEMA=langgraph
# true => `ensure_checkpointer` aborts the boot chain when the checkpointer
# cannot be initialized, instead of degrading silently to an unpersisted
# runtime (BL-20260811-27). Default false: a slow Postgres at cold boot should
# not take the container down.
LANGGRAPH_CHECKPOINTER_REQUIRED=false

# === LangGraph Studio (dev tool, compose profile `studio`, BL-20260502-01) ===
# `make studio-up` self-hosts langchain/langgraph-api serving the same
# LegalWorkflow graph the API runs, so you can step through it visually. Inert
# until you set a key here: the server validates it against beacon.langchain.com
# at boot and exits without one (free developer key at smith.langchain.com), and
# the stepper UI itself is hosted there. Nothing about this is a runtime LLM
# path. See "LangGraph Studio" in docs/local-ai.md.
# LANGSMITH_API_KEY=
# Prompt/response export to LangSmith. Off by default on purpose — the license
# ping carries no prompt text, this would.
LANGSMITH_TRACING=false
# Provider chain the Studio host runs on. Local by default so re-running a node
# twenty times in the stepper cannot bill a hosted provider.
STUDIO_LLM_PROVIDER_CHAIN=ollama

# === Observability (spec 010 FR-4) ===
# Self-hosted Arize Phoenix endpoint. Leave PHOENIX_COLLECTOR_ENDPOINT blank
# to disable OTEL export (recommended for tests + offline runs).
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_UI_URL=http://localhost:6006
PHOENIX_PROJECT_NAME=law_ai
# Which observability backend the OTEL exporter targets (BL-20260502-07):
# phoenix (default) | langfuse | none. The abstraction exists so a licensing
# change at one vendor is a config edit, not a code change.
OBSERVABILITY_BACKEND=phoenix
# Langfuse inputs, used only when OBSERVABILITY_BACKEND=langfuse. Both keys are
# required; the exporter posts to <host>/api/public/otel/v1/traces with Basic auth.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Any other OTLP/HTTP collector. When set, this overrides the backend's own
# endpoint; headers use the OTLP `k=v,k=v` form.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# === Databases ===
# POSTGRES_URL is HOST-oriented (localhost) and is read only by the LangGraph
# checkpointer via `settings.POSTGRES_URL` — Django's ORM uses DATABASE_URL,
# which is a different setting with a different driver prefix. Inside Docker
# this value is overridden per service in docker-compose.yml (hostname
# `postgres`, not `localhost`), so the container never sees what is set here;
# the value below matters only for host-side use, e.g. `docker compose run`
# with `--env-file` or the emergency `host-*` make targets.
#
# If a stale `.env` still carries the pre-rename `lawgraph`/`lawgraph-dev`
# credentials, host-side checkpointer calls fail authentication against a
# database that no longer exists under that name. Regenerate from this file
# rather than hand-patching (BL-20260811-29).
POSTGRES_URL=postgresql+asyncpg://law_ai:law_ai-dev@localhost:5432/law_ai
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=law_ai-dev

# === External APIs (optional but recommended) ===
COURTLISTENER_API_KEY=your_key_here          # Get from https://www.courtlistener.com/api/
COURTLISTENER_API_TOKEN=                     # Alias supported by CourtListenerClient
RECAP_EMAIL=your_pacer_email@example.com
RECAP_PASSWORD=your_pacer_password
# Denver Revised Municipal Code (BL-20260509-05). The shipped workflow parses
# LOCAL HTML (`--chapter-dir`) and never fetches: library.municode.com's terms
# prohibit systematic downloading. Set this only to a mirror you are permitted
# to crawl. Either way every ordinance section is held for human review.
DENVER_MUNICIPAL_CODE_BASE_URL=

# === Feature Flags ===
ENABLE_LEGALBENCH_EVAL=true
ENABLE_HUMAN_APPROVAL_GATES=true
# Optional spaCy NER pass in IngestionScout (BL-20260429-03). Needs the model
# wheel from the `nlp` extra: pip install -e ".[nlp]". Off by default.
ENABLE_NER=false
LOCAL_ONLY_MODE=true

# === Frontend ===
# Where the browser sends API calls. `/api/backend` is the Next.js proxy route
# that attaches the API key server-side (BL-20260430-07); point it straight at
# the API only for a deployment with no key configured.
NEXT_PUBLIC_API_BASE_URL=/api/backend
# Where the proxy forwards to, from inside the Next.js server. Server-only.
BACKEND_INTERNAL_URL=http://backend:8000
# WebSocket origin. A route handler cannot upgrade a connection, so the agent
# stream still talks to the backend directly, with a short-lived ticket minted
# by /api/ws-ticket instead of a key in the bundle.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# === Auth (optional, recommended for non-localhost — specs 008 + 009) ===
# Backend: when set, /api/agents/* requires a matching X-API-Key header.
# As of spec 009, AGENT_API_KEY ALSO gates /api/analysis, /api/graph/*, and
# /api/lsat/* unless overridden by the per-router keys below.
# Leave blank for local dev to keep all feature routers public on localhost.
AGENT_API_KEY=

# --- Agent stream + ops dashboard push (BL-20260429-16, BL-20260811-14) ---
# The ops dashboard subscribes to /ws/agents/ops and refreshes when something
# changes, instead of polling six REST endpoints every five seconds. Set false
# to go back to polling only.
AGENT_OPS_PUSH_ENABLED=true
# Where the per-stream replay ring buffer lives, so a client whose socket
# dropped can reconnect with ?since=<seq> and catch up on what it missed.
# Blank = the same REDIS_URL as everything else; there is no need to set it
# unless you want the buffer on a separate instance.
AGENT_STREAM_REPLAY_URL=
# Per-router overrides (spec 009). When set, the matching router enforces
# this key INSTEAD OF the shared AGENT_API_KEY. When blank, the router
# falls back to AGENT_API_KEY. When both are blank, the router stays open.
ANALYSIS_API_KEY=
GRAPH_API_KEY=
LSAT_API_KEY=
# Web quarantine review queue, /api/ingestion/* (BL-20260811-01).
INGESTION_API_KEY=
# May a newly persisted analysis ever be given a public /shared/<slug> link
# (BL-20260429-26)? Set false where matters carry a confidentiality obligation:
# minting is then refused for every new run. Existing rows keep their flag.
ANALYSIS_SHAREABLE_DEFAULT=true
# Matter task reminders (BL-20260817-02). The in-app calendar
# (/api/matters/calendar) always works; email is opt-in and goes through
# Django's configured mail backend. Lead time is hours before the due date.
MATTER_TASK_EMAIL_REMINDERS=false
MATTER_TASK_REMINDER_LEAD_HOURS=24
# Rate limits on LLM-invoking endpoints. `LLM_THROTTLE_RATE` is the anonymous
# per-IP bucket; `LLM_KEYED_THROTTLE_RATE` applies once a caller is identified
# by API token or signed-in session, which is what keeps a shared proxy from
# holding every user to one bucket (BL-20260811-06). A single ApiToken may
# override both via its `rate_limit` column.
LLM_THROTTLE_RATE=20/min
LLM_KEYED_THROTTLE_RATE=60/min
# Write the AuditEvent row from a worker thread when Celery runs eagerly inside
# an async context (BL-20260811-07). settings/dev.py forces this on for dev/prod
# parity; the test suite forces it off. JSONL remains the record either way.
AUDIT_DB_THREAD_OFFLOAD=false
# Blind-solve each approved LSAT draft once for regression tracking (one provider call per approval)
LSAT_CROSS_CHECK_ON_APPROVE=true
# Serve the LSAT HITL queue from the indexed LsatProposal table instead of the
# JSONL replay. Run `make manage CMD='lsat_proposals_backfill'` first, or older
# proposals stay invisible; the JSONL log remains the audit trail either way.
LSAT_PROPOSALS_DB_READS=false
# The frontend has no key of its own any more (BL-20260430-07). The Next.js
# server reads AGENT_API_KEY above — give the frontend container the same
# value — and attaches it in `app/api/backend/[...path]/route.ts`; it signs
# the WebSocket ticket with it too. Nothing secret reaches the browser, so
# there is no NEXT_PUBLIC_AGENT_API_KEY: a NEXT_PUBLIC_* secret is not one.
# === Autonomy Loop (spec 018, constitution §12) ===
# Kill-switch: set to True only in supervised environments.
AUTONOMY_ENABLED=False
# Comma-separated list of allowed source IDs (e.g. "courtlistener,colorado_statutes").
# Empty = no sources allowed even if AUTONOMY_ENABLED=True.
AUTONOMY_ALLOWED_SOURCES=
# Directory where daily digest Markdown files are written.
# Inside Docker containers /app == ./backend on host, so use var/autonomy.
# Outside Docker (host scripts), use backend/var/autonomy.
AUTONOMY_DIGEST_DIR=var/autonomy
# Maximum items ingested per autonomous cycle (hard cap, independent of source).
AUTONOMY_MAX_INGEST_PER_CYCLE=25
# Digest delivery (BL-20260511-05). Both are OFF by default: with neither set
# the digest-<date>.md file stays the only surface, exactly as before.
# Slack incoming-webhook URL. SECRET — the path segments are the credential,
# so this stays in .env and only "host/…<fingerprint>" reaches the audit log.
# A digest over Slack's 40 000-char `text` cap is truncated with a pointer to
# the file on disk.
AUTONOMY_DIGEST_SLACK_WEBHOOK_URL=
# Comma-separated recipients for the same digest. Empty = no mail is sent.
AUTONOMY_DIGEST_EMAIL_TO=
AUTONOMY_DIGEST_EMAIL_FROM=law-ai-autonomy@localhost
# Django mail backend. The console default prints the message instead of
# sending it, so a half-configured deployment is visible rather than silent.
# Real SMTP: django.core.mail.backends.smtp.EmailBackend (plus EMAIL_HOST etc.).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
