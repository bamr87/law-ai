{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },

  // Python — lint/format config lives in backend/pyproject.toml (ruff, black,
  // mypy). The extensions resolve it per-file, so no args are duplicated here:
  // duplicated args drift from the canonical config (and `ruff.lint.args` is
  // deprecated by the ruff extension's native server anyway).
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit"
    }
  },
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.autoImportCompletions": true,
  // Docker-first: there is deliberately NO host venv. Pylance uses the
  // default interpreter for IntelliSense; run/test/lint always go through
  // `make …` / the tasks in tasks.json (see AGENTS.md).

  // TypeScript / React / Next.js
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // Host path, and it only resolves if someone has run `npm install` on the
  // host — which the Docker-first rule forbids. Inside the frontend dev
  // container (.devcontainer/frontend/devcontainer.json) the workspace root
  // IS /app, so that config overrides this with "node_modules/typescript/lib"
  // and the editor uses the container's toolchain. BL-20260811-17.
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  // Same story: correct for a host-rooted workspace, overridden to ["."] in
  // the frontend dev container where /app is already the package root.
  "eslint.workingDirectories": ["frontend"],

  // General
  "files.associations": {
    "*.md": "markdown",
    "AGENTS.md": "markdown",
    "*.cypher": "cypher"
  },
  "markdown.preview.breaks": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/dist": true,
    "**/.next": true,
    "**/htmlcov": true
  },

  // Recommended for this project
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#0f172a",
    "titleBar.activeForeground": "#e0f2fe"
  },
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}/backend"
  },
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}/backend"
  }
}
