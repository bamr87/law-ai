.cache/

# Django
staticfiles/
backend/staticfiles/
media/

# Runtime artifacts (audit logs, build info)
.audit/
backend/.audit/
*.tsbuildinfo

# xAI OAuth credentials (spec 050) — rotating subscription tokens, never source
.xai/
backend/.xai/

# Celery beat runtime schedule (generated by worker; not source)
backend/celerybeat-schedule
backend/celerybeat-schedule.db

# Autonomy digest files (generated at runtime; keep .gitkeep only)
backend/var/autonomy/digest-*.md

# LSAT content-factory operational artifacts (spec 024 — manifests, drafts,
# parked passages are runtime data, never source)
backend/var/lsat_factory/

# LSAT static-site exporter scratch output (spec 025 — the committed copy
# lives at frontend/public/lsat-practice/data/)
backend/var/lsat_site/

# LegalBench run artifacts (spec 031 — per-run reports and the append-only
# score history are runtime state; CI keeps them as artifacts instead).
# baseline.json is deliberately NOT ignored: it is the tracked reference
# the regression gate compares against. LICENSES.md stays tracked too.
backend/var/legalbench/*.json
!backend/var/legalbench/baseline.json
backend/var/legalbench/history.jsonl
backend/var/legalbench/*/items.jsonl

# Playwright MCP session artifacts (screenshots, snapshots)
.playwright-mcp/

# Stray Docker bind-mount artifact (backend container writes into backend/backend/)
backend/backend/

# Data & Logs
*.log
audit.out
htmlcov/
.coverage
coverage/
*.db
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Docker volumes (local only)
volumes/
# design-sync (claude.ai/design) — staged scripts + regenerated output
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
