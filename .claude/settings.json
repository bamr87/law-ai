{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "bamr87": {
      "source": {
        "source": "github",
        "repo": "bamr87/bamr87",
        "sparsePaths": [".claude-plugin", "templates/spec-driven"]
      }
    }
  },
  "enabledPlugins": {
    "spec-driven@bamr87": true
  },
  "permissions": {
    "deny": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(poetry run:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(black:*)",
      "Bash(python manage.py:*)",
      "Bash(python3 manage.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
