    "LsatGradeRequest": {
      "properties": {
        "choice": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ],
          "title": "Choice",
          "type": "string"
        },
        "hints_used": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hints Used"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "remap": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remap"
        }
      },
      "required": [
        "question_id",
        "choice"
      ],
      "title": "GradeRequest",
      "type": "object"
    },
    "LsatGradeResponse": {
      "properties": {
        "concepts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Concepts",
          "type": "array"
        },
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "correct_choice": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ],
          "title": "Correct Choice",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "section": {
          "enum": [
            "LR",
            "RC",
            "LG",
            "WS"
          ],
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "correct",
        "correct_choice",
        "explanation",
        "section"
      ],
      "title": "GradeResponse",
      "type": "object"
    },
    "LsatQuestion": {
      "$defs": {
        "Choice": {
          "properties": {
            "label": {
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E"
              ],
              "title": "Label",
              "type": "string"
            },
            "text": {
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "label",
            "text"
          ],
          "title": "Choice",
          "type": "object"
        },
        "Reference": {
          "properties": {
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            },
            "title": {
              "title": "Title",
              "type": "string"
            },
            "url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Url"
            }
          },
          "required": [
            "title"
          ],
          "title": "Reference",
          "type": "object"
        }
      },
      "description": "Question payload returned to clients (no answer key).",
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "title": "Choices",
          "type": "array"
        },
        "concepts": {
          "items": {
            "type": "string"
          },
          "title": "Concepts",
          "type": "array"
        },
        "difficulty": {
          "enum": [
            "intro",
            "easy",
            "med",
            "hard",
            "elite"
          ],
