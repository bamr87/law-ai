{
    // VS Code debug configurations for Law AI — DOCKER-ONLY.
    //
    // All configs attach to processes running inside `docker compose` services.
    // They do NOT spawn local Python/Node processes.
    //
    // Flow:
    //   1. Start the debug stack: `make debug`
    //      (or task "Docker: Start Full Stack (Debug)") — this layers
    //      docker-compose.debug.yml over docker-compose.yml, exposing:
    //        5678 backend debugpy · 5679 worker debugpy ·
    //        9229 frontend CLI inspector · 9230 frontend dev-server inspector
    //   2. Attach with one of the configs below (or the compound).
    //
    // Note: the frontend runs Next.js with NODE_OPTIONS=--inspect, so the
    // CLI process binds 9229 and the actual dev server (App Router server
    // components / route handlers) auto-increments to 9230 — attach to 9230
    // for server-side breakpoints.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Docker: Attach to backend (debugpy)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/backend",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": false,
            "django": true
        },
        {
            "name": "Docker: Attach to worker (debugpy)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5679
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/backend",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": false
        },
        {
            "name": "Docker: Attach to frontend server (node)",
            "type": "node",
            "request": "attach",
            "address": "localhost",
            "port": 9230,
            "localRoot": "${workspaceFolder}/frontend",
            "remoteRoot": "/app",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Docker: Attach to frontend CLI (node)",
            "type": "node",
            "request": "attach",
            "address": "localhost",
            "port": 9229,
            "localRoot": "${workspaceFolder}/frontend",
            "remoteRoot": "/app",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Docker: Open frontend in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend"
        }
    ],
    "compounds": [
        {
            "name": "Docker: Attach to full stack (backend + worker + frontend)",
            "configurations": [
                "Docker: Attach to backend (debugpy)",
                "Docker: Attach to worker (debugpy)",
                "Docker: Attach to frontend server (node)"
            ],
            "stopAll": true
        }
    ]
}
