          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "passage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passage Id"
        },
        "references": {
