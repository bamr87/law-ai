{
  "uid": "law-ai-local-ai",
  "title": "Law AI — local inference",
  "description": "Server / multi-GPU tier (BL-20260502-03): tokens/sec, GPU utilization, queue depth. Provisioned from infra/grafana/dashboards/local-ai.json — edit the file, not the UI.",
  "tags": ["law-ai", "local-ai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tokens/sec (vLLM)",
      "description": "Generation throughput. Zero-valued when the vllm profile is not running.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "tok/s", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
          "legendFormat": "output"
        },
        {
          "refId": "B",
          "expr": "sum(rate(vllm:prompt_tokens_total[1m]))",
          "legendFormat": "prompt"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU utilization",
      "description": "DCGM_FI_DEV_GPU_UTIL per card — the multi-GPU view: one series per gpu label.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "gpu {{gpu}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU memory used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "decmbytes" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_FB_USED",
          "legendFormat": "gpu {{gpu}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Celery queue depth",
      "description": "A Celery queue is a Redis list, so redis_key_size on `celery` and `autonomy` is the number of tasks waiting for the worker.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_key_size{key=~\"celery|autonomy\"}",
          "legendFormat": "{{key}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "vLLM request queue",
      "description": "Requests running vs waiting — the inference-side counterpart to Celery queue depth.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vllm:num_requests_running)",
          "legendFormat": "running"
        },
        {
          "refId": "B",
          "expr": "sum(vllm:num_requests_waiting)",
          "legendFormat": "waiting"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "Targets legitimately sit at DOWN when their tier is not running (no GPU, no vLLM).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
