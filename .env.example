# LawGraph AI Environment Configuration
# Copy to .env and fill in values

# === LLM (Ollama recommended for privacy) ===
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.1:70b-q4_K_M
FALLBACK_MODEL=mistral:7b-instruct-q4_K_M
# Spec 010: model the LangGraph LegalWorkflow uses by default. Apple Silicon
# laptops should keep this at the 7B Mistral; bump to llama3.1:8b on 64 GB+
# machines or llama3.1:70b-q4_K_M on workstations with NVIDIA GPUs.
OLLAMA_DEFAULT_MODEL=mistral:7b-instruct-q4_K_M

# === LangGraph state persistence (spec 010 FR-2) ===
# postgres = durable (default), redis = fast queues, memory = tests only.
LANGGRAPH_CHECKPOINTER=postgres

# === Observability (spec 010 FR-4) ===
# Self-hosted Arize Phoenix endpoint. Leave PHOENIX_COLLECTOR_ENDPOINT blank
# to disable OTEL export (recommended for tests + offline runs).
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_UI_URL=http://localhost:6006
PHOENIX_PROJECT_NAME=lawgraph

# === Databases ===
POSTGRES_URL=postgresql+asyncpg://lawgraph:lawgraph-dev@localhost:5432/lawgraph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lawgraph-dev

# === External APIs (optional but recommended) ===
COURTLISTENER_API_KEY=your_key_here          # Get from https://www.courtlistener.com/api/
COURTLISTENER_API_TOKEN=                     # Alias supported by CourtListenerClient
RECAP_EMAIL=your_pacer_email@example.com
RECAP_PASSWORD=your_pacer_password

# === Feature Flags ===
ENABLE_LEGALBENCH_EVAL=true
ENABLE_HUMAN_APPROVAL_GATES=true
LOCAL_ONLY_MODE=true

# === Frontend ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# === Auth (optional, recommended for non-localhost — specs 008 + 009) ===
# Backend: when set, /api/agents/* requires a matching X-API-Key header.
# As of spec 009, AGENT_API_KEY ALSO gates /api/analysis, /api/graph/*, and
# /api/lsat/* unless overridden by the per-router keys below.
# Leave blank for local dev to keep all feature routers public on localhost.
AGENT_API_KEY=
# Per-router overrides (spec 009). When set, the matching router enforces
# this key INSTEAD OF the shared AGENT_API_KEY. When blank, the router
# falls back to AGENT_API_KEY. When both are blank, the router stays open.
ANALYSIS_API_KEY=
GRAPH_API_KEY=
LSAT_API_KEY=
# Frontend: must match AGENT_API_KEY (or every per-router key) when the
# gate is enabled. Note this value is bundled into the client JS — see
# specs/008-agent-api-auth R-2 and BL-20260430-07.
NEXT_PUBLIC_AGENT_API_KEY=
# === Autonomy Loop (spec 018, constitution §12) ===
# Kill-switch: set to True only in supervised environments.
AUTONOMY_ENABLED=False
# Comma-separated list of allowed source IDs (e.g. "courtlistener,colorado_statutes").
# Empty = no sources allowed even if AUTONOMY_ENABLED=True.
AUTONOMY_ALLOWED_SOURCES=
# Directory where daily digest Markdown files are written.
AUTONOMY_DIGEST_DIR=backend/var/autonomy
# Maximum items ingested per autonomous cycle (hard cap, independent of source).
AUTONOMY_MAX_INGEST_PER_CYCLE=25
