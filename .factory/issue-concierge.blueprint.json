{
  "version": 1,
  "meta": {
    "name": "Issue Concierge",
    "description": "New issues get a triage label + ONE short routing comment (bot-guarded, default-OFF)."
  },
  "nodes": [
    {
      "id": "t",
      "type": "trigger.issue_opened",
      "position": {
        "x": 40,
        "y": 140
      },
      "config": {}
    },
    {
      "id": "g",
      "type": "gate.enablement",
      "position": {
        "x": 250,
        "y": 140
      },
      "config": {
        "variable": "ISSUE_CONCIERGE_ENABLED"
      }
    },
    {
      "id": "a",
      "type": "agent.claude",
      "position": {
        "x": 460,
        "y": 140
      },
      "config": {
        "promptRef": ".factory/prompts/issue-concierge.md",
        "model": "claude-sonnet-5-5",
        "maxTurns": 10
      }
    },
    {
      "id": "lb",
      "type": "sink.label",
      "position": {
        "x": 730,
        "y": 60
      },
      "config": {
        "labels": ""
      }
    },
    {
      "id": "cm",
      "type": "sink.comment",
      "position": {
        "x": 730,
        "y": 220
      },
      "config": {
        "instruction": "posts ONE short triage comment (kind/severity guess + where it lands in BACKLOG.md); never posts a second comment on the same issue"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "t",
        "port": "out"
      },
      "to": {
        "node": "g",
        "port": "in"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "g",
        "port": "out"
      },
      "to": {
        "node": "a",
        "port": "in"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "a",
        "port": "out"
      },
      "to": {
        "node": "lb",
        "port": "in"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "a",
        "port": "out"
      },
      "to": {
        "node": "cm",
        "port": "in"
      }
    }
  ]
}
